# ===== نشامى ستور - إعدادات الفرونت أند =====

# رابط الـ API
# أثناء التطوير: /api (يستخدم Vite proxy)
# في الإنتاج: https://api.nashamastore.com/api
VITE_API_URL=/api

# مفتاح الـ API السري (يُرسل في Header: x-api-key)
# يجب أن يطابق STORE_SECRET_KEY في السيرفر
# ملاحظة: يمكن لأي زائر رؤيته من كود المتصفح - الحماية الحقيقية من CORS وتقييد الطلبات
VITE_STORE_SECRET_KEY=
